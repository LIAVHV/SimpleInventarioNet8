@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="page-heading">
    <div>
        <h2>Resumen general</h2>
        <p>Indicadores y actividad reciente del inventario.</p>
    </div><span class="text-muted">
        @DateTime.Now.ToString("dddd, dd MMMM yyyy", new
        System.Globalization.CultureInfo("es-MX"))
    </span>
</div>
<div class="row row-cols-2 row-cols-xl-4 g-3 mb-4">
    <div class="col">
        <div class="stat-card">
            <span class="stat-icon">▤</span>
            <div class="stat-label">PRODUCTOS</div>
            <div class="stat-value">@Model.TotalProductos</div><a asp-controller="Productos" asp-action="Index" class="small text-decoration-none">Ver catálogo →</a>
        </div>
    </div>
    <div class="col">
        <div class="stat-card">
            <span class="stat-icon">◫</span>
            <div class="stat-label">UNIDADES DE MEDIDA</div>
            <div class="stat-value">@Model.TotalUnidades</div><a asp-controller="Unidades" asp-action="Index"
                                                                 class="small text-decoration-none">Ver unidades →</a>
        </div>
    </div>
    <div class="col">
        <div class="stat-card">
            <span class="stat-icon">▥</span>
            <div class="stat-label">EXISTENCIAS TOTALES</div>
            <div class="stat-value">@Model.TotalExistencias.ToString("N2")</div><span class="small text-muted">
                Suma de
                cantidades
            </span>
        </div>
    </div>
    <div class="col">
        <div class="stat-card">
            <span class="stat-icon">$</span>
            <div class="stat-label">VALOR DEL INVENTARIO</div>
            <div class="stat-value" style="font-size:23px">@Model.ValorInventario.ToString("C2")</div><span class="small text-muted">Existencia × precio actual</span>
        </div>
    </div>

    <div class="col">
        <div class="stat-card h-100">
            <div class="stat-label">MOVIMIENTOS REGISTRADOS</div>
            <div class="d-flex justify-content-between mt-3">
                <div><div class="stat-value">@Model.TotalEntradas</div><span class="small text-muted">Entradas</span></div>
                <div><div class="stat-value">@Model.TotalSalidas</div><span class="small text-muted">Salidas</span></div>
            </div><div class="d-flex gap-2 mt-4"><a asp-controller="Entradas" asp-action="Create" class="btn btn-primary flex-fill">＋ Registrar entrada</a><a asp-controller="Salidas" asp-action="Create" class="btn btn-outline-secondary flex-fill">－ Registrar salida</a></div>
        </div>
    </div>

    <div class="col">
        <div class="stat-card">
            <span class="stat-icon">⚠</span>

            <div class="stat-label">
                PRODUCTOS SIN EXISTENCIA
            </div>

            <div class="stat-value">
                @Model.TotalProductosSinExistencia
            </div>

            <a asp-controller="Productos"
               asp-action="SinExistencia"
               class="small text-decoration-none">
                Ver productos sin existencia →
            </a>
        </div>
    </div>


    <div class="col">
        <div class="stat-card">
            <span class="stat-icon">⚠</span>

            <div class="stat-label">
                PRODUCTOS POR RESURTIR
            </div>

            <div class="stat-value">
                @Model.TotalProductosPorResurtir
            </div>

            <a asp-controller="Productos"
               asp-action="StockBajo"
               class="small text-decoration-none">
                Ver productos por resurtir →
            </a>
        </div>
    </div>


</div>
