@model SalidaViewModel
@{
    ViewData["Title"] = "Registrar salida";
}
<div class="page-heading">
    <div>
        <h2>Registrar salida</h2>
        <p>El sistema validará y descontará las existencias disponibles.</p>
    </div><a asp-action="Index" class="btn btn-outline-secondary">← Historial</a>
</div>
<div class="panel" style="max-width:760px">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="mb-3"></div>

        <div class="row g-3 mt-2">
            <div class="col-md-6">
                <div class="info-strip">Existencia actual: <strong data-current-stock>—</strong></div>
            </div>
            <div class="col-md-6">
                <div class="info-strip">Precio Venta: <strong data-current-price>—</strong></div>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="ProductoId" class="form-label"></label><select asp-for="ProductoId" asp-items="ViewBag.Productos" class="form-select" data-product-details="@Url.Action("Datos", "Productos")">
                <option value="">Selecciona un producto</option>
            </select><span asp-validation-for="ProductoId" class="field-validation-error"></span>
        </div>
        <div class="col">
            <div class="col-md-6">
                <input asp-for="PrecioVenta" class="form-control" hidden />
                <span asp-validation-for="PrecioVenta" class="field-validation-error"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Cantidad" class="form-label"></label><input asp-for="Cantidad" class="form-control" type="number" step="0.01" min="0.01" /><span asp-validation-for="Cantidad"
                                                                                                                                                                 class="field-validation-error"></span>
            </div>
        </div>
        <div class="info-strip mt-3">
            El importe de la salida se registra en negativo en el Kardex. El servidor vuelve a
            validar el stock al guardar.
        </div>
        <div class="form-actions">
            <button class="btn btn-primary">Guardar salida</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>