<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SimpleInventario</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar d-print-none">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">SI</span><span>SimpleInventario<small>CONTROL DE INVENTARIO</small></span></a>
            <div class="nav-caption">GENERAL</div>
            <a class="nav-link" asp-controller="Home" asp-action="Index">▦ <span>Dashboard</span></a>
            <div class="nav-caption">CATÁLOGOS</div>
            <a class="nav-link" asp-controller="Unidades" asp-action="Index">◫ <span>Unidades</span></a>
            <a class="nav-link" asp-controller="Proveedores" asp-action="Index"> ◉ <span>Proveedores</span>
            <a class="nav-link" asp-controller="Productos" asp-action="Index">▤ <span>Productos</span></a>
            </a>

            <div class="nav-caption">MOVIMIENTOS</div>
            <a class="nav-link" asp-controller="Entradas" asp-action="Index">↓ <span>Entradas</span></a>
            <a class="nav-link" asp-controller="Salidas" asp-action="Index">↑ <span>Salidas</span></a>
            <div class="nav-caption">CONSULTAS</div>
            <a class="nav-link" asp-controller="Productos" asp-action="SinExistencia">▥ <span>Sin Existencias</span></a>
            <a class="nav-link" asp-controller="Reportes" asp-action="Existencias">▥ <span>Existencias</span></a>
            <a class="nav-link" asp-controller="Reportes" asp-action="Kardex">☷ <span>Kardex</span></a>
            <div class="sidebar-footer">Sistema de inventario<br /><span>ASP.NET Core MVC · .NET 8</span></div>
        </aside>
        <main class="main-area">
            <header class="topbar"><div><span class="eyebrow">ADMINISTRACIÓN</span><h1>@ViewData["Title"]</h1></div><div class="topbar-tag">Inventario</div></header>
            <section class="content-area">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @RenderBody()
            </section>
            <footer class="footer">SimpleInventario <span>·</span> Gestión de productos y movimientos</footer>
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
