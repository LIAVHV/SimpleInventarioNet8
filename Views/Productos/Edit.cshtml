@model Productos
@{
    ViewData["Title"] = "Editar producto";
}
<div class="page-heading">
    <div>
        <h2>Editar producto</h2>
        <p>Modifica su descripción o unidad de medida.</p>
    </div><a asp-action="Index" class="btn btn-outline-secondary">← Regresar</a>
</div>
<div class="panel" style="max-width:700px">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="ProductosId" />
        <div asp-validation-summary="ModelOnly" class="mb-3"></div>
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre"
                                                                      class="form-control" /><span asp-validation-for="Nombre" class="field-validation-error"></span>
        </div>
        <div class="mb-3">
            <label asp-for="FkUnidadesId" class="form-label"></label><select asp-for="FkUnidadesId"
                                                                             asp-items="ViewBag.Unidades" class="form-select"></select><span asp-validation-for="FkUnidadesId"
                                                                                                                                             class="field-validation-error"></span>
        </div>
        <div class="info-strip">
            Precio actual: <strong>@Model.Precio.ToString("C2")</strong> · Existencia:
            <strong>@Model.Existencia.ToString("N2")</strong>. Estos valores se conservan sin cambios.
        </div>

        <div class="mb-3">
            <label asp-for="StockMinimo" class="form-label"></label>
            <input asp-for="StockMinimo"
                   class="form-control"
                   type="number"
                   min="0"
                   step="0.01" />
            <span asp-validation-for="StockMinimo"
                  class="field-validation-error"></span>
        </div>


        <div class="form-actions">
            <button class="btn btn-primary">Guardar cambios</button><a asp-action="Index"
                                                                       class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>