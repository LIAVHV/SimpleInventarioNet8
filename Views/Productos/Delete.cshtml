@model Productos
@{ ViewData["Title"] = "Eliminar producto"; }
<div class="page-heading"><div><h2>Eliminar producto</h2><p>Verifica el producto antes de continuar.</p></div><a asp-action="Index" class="btn btn-outline-secondary">← Regresar</a></div>
<div class="panel" style="max-width:700px"><div class="alert alert-warning">No se pueden eliminar productos que tengan entradas o salidas registradas.</div><dl class="row"><dt class="col-sm-4">Producto</dt><dd class="col-sm-8">@Model.Nombre</dd><dt class="col-sm-4">Unidad</dt><dd class="col-sm-8">@Model.Unidades?.Unidad</dd><dt class="col-sm-4">Existencia</dt><dd class="col-sm-8">@Model.Existencia.ToString("N2")</dd></dl><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@Model.ProductosId"/><div class="form-actions"><button class="btn btn-danger" data-confirm="¿Eliminar este producto?">Eliminar producto</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div></form></div>
