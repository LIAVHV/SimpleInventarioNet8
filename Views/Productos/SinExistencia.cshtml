@model SimpleInventario.Web.Models.Paginar<Productos>

@{
    ViewData["Title"] = "Productos sin existencia";
}

<div class="page-heading">
    <div>
        <h2>Productos sin existencia</h2>
        <p>Productos que requieren reabastecimiento.</p>
    </div>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Volver al Dashboard
    </a>
</div>

<div class="panel">

    <form method="get" class="d-flex gap-2 mb-3">
        <input class="form-control search-box"
               name="q"
               value="@ViewBag.Query"
               placeholder="Buscar producto..." />

        <button type="submit"
                class="btn btn-outline-secondary">
            Buscar
        </button>

        <a asp-action="SinExistencia"
           class="btn btn-outline-secondary">
            Limpiar
        </a>
    </form>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fs-6 fw-bold mb-0">
            Productos encontrados
        </h5>

        <span class="badge-out">
            Total: @Model.Count
        </span>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>PRODUCTO</th>
                    <th>UNIDAD</th>
                    <th class="text-end">PRECIO</th>
                    <th class="text-end">EXISTENCIA</th>
                    <th class="text-end">ACCIONES</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.ProductosId</td>

                        <td class="fw-semibold">
                            @p.Nombre
                        </td>

                        <td>@p.Unidades?.Unidad</td>

                        <td class="text-end">
                            @p.Precio.ToString("C2")
                        </td>

                        <td class="text-end">
                            @p.Existencia.ToString("N2")
                        </td>

                        <td>
                            <div class="action-links justify-content-end">
                                <a asp-action="Edit"
                                   asp-route-id="@p.ProductosId">
                                    Editar
                                </a>
                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                No hay productos sin existencia.
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination",
    new PaginacionViewModel
    {
        PaginaIndice = Model.PaginaIndice,
        TotalPaginas = Model.TotalPaginas,
        ItemsPorPagina = Model.ItemsPorPagina,
        Modelo = "Productos",
        Accion = "SinExistencia",
        Query = ViewBag.Query
    })

</div>
