@model EntradaViewModel
@{
    ViewData["Title"] = "Registrar entrada";
}
<div class="page-heading">
    <div>
        <h2>Registrar entrada</h2>
        <p>El ingreso aumentará la existencia y actualizará el precio vigente.</p>
    </div><a asp-action="Index" class="btn btn-outline-secondary">← Historial</a>
</div>
<div class="panel" style="max-width:760px">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="mb-3"></div>
        <div class="mb-3">
            <label asp-for="ProductoId" class="form-label"></label><select asp-for="ProductoId"
                                                                           asp-items="ViewBag.Productos" class="form-select" data-product-details="@Url.Action("Datos", "Productos")">
                <option value="">Selecciona un producto</option>
            </select><span asp-validation-for="ProductoId" class="field-validation-error"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ProveedorId" class="form-label"></label>
            <select asp-for="ProveedorId" asp-items="ViewBag.Proveedores" class="form-select">
                <option value="">Selecciona un proveedor</option>
            </select>
            <span asp-validation-for="ProveedorId" class="field-validation-error"></span>
        </div>


        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Precio" class="form-label"></label>
                <input asp-for="Precio" class="form-control" type="number" min="0.01" step="0.01" />
                <span asp-validation-for="Precio" class="field-validation-error"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PrecioVenta" class="form-label"></label>
                <input asp-for="PrecioVenta" class="form-control" type="number" min="0.01" step="0.01" />
                <span asp-validation-for="PrecioVenta" class="field-validation-error"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Cantidad" class="form-label"></label>
                <input asp-for="Cantidad" class="form-control" type="number" min="0.01" step="0.01" />
                <span asp-validation-for="Cantidad" class="field-validation-error"></span>
            </div>

        </div>

        <div class="row g-3 mt-2">
            <div class="col-md-6">
                <div class="info-strip">Existencia actual: <strong data-current-stock>—</strong></div>
            </div>
            <div class="col-md-6">
                <div class="info-strip">Importe calculado: <strong data-total>$0.00</strong></div>
            </div>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary">Guardar entrada</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>