@model Unidades
@{ ViewData["Title"] = "Nueva unidad"; }
<div class="page-heading"><div><h2>Registrar unidad</h2><p>Agrega una unidad de medida al catálogo.</p></div><a asp-action="Index" class="btn btn-outline-secondary">← Regresar</a></div>
<div class="panel" style="max-width:650px"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="mb-3"></div><label asp-for="Unidad" class="form-label"></label><input asp-for="Unidad" class="form-control" placeholder="Ej. PIEZA, KILOGRAMO, SERVICIO"/><span asp-validation-for="Unidad" class="field-validation-error"></span><div class="form-actions"><button class="btn btn-primary">Guardar unidad</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div></form></div>
